{
  "policy_id": "001B7A44BDAA510F",
  "name": "Shared Compute",
  "description": "Shared with teams for interactive data exploration, data analysis, and machine learning.",
  "policy_family_id": "shared-compute",
  "is_default": true,
  "definition": {
    "autoscale.max_workers": {
      "type": "unlimited",
      "defaultValue": 10
    },
    "autoscale.min_workers": {
      "type": "unlimited",
      "defaultValue": 2
    },
    "autotermination_minutes": {
      "type": "unlimited",
      "defaultValue": 0,
      "isOptional": true
    },
    "azure_attributes.availability": {
      "type": "unlimited",
      "defaultValue": "ON_DEMAND_AZURE"
    },
    "azure_attributes.spot_bid_max_price": {
      "type": "fixed",
      "value": -1,
      "hidden": true
    },
    "cluster_type": {
      "type": "fixed",
      "value": "all-purpose"
    },
    "data_security_mode": {
      "type": "fixed",
      "value": "USER_ISOLATION",
      "hidden": true
    },
    "driver_instance_pool_id": {
      "type": "forbidden",
      "hidden": true
    },
    "instance_pool_id": {
      "type": "forbidden",
      "hidden": true
    },
    "node_type_id": {
      "type": "unlimited",
      "defaultValue": "Standard_D8ds_v5",
      "isOptional": true
    },
    "num_workers": {
      "type": "forbidden",
      "hidden": true
    },
    "spark_conf.spark.databricks.cluster.profile": {
      "type": "forbidden",
      "hidden": true
    },
    "spark_version": {
      "type": "unlimited",
      "defaultValue": "auto:latest-lts"
    }
  }
}
